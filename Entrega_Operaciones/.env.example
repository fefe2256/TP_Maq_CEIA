# Copiar este archivo como .env y completar los valores

# Airflow
AIRFLOW_UID=501                  # Resultado de: id -u (Linux/Mac)
AIRFLOW_GID=0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# PostgreSQL
PG_USER=airflow
PG_PASSWORD=airflow
PG_DATABASE=airflow
PG_PORT=5432

# MLflow
MLFLOW_PORT=5001
MLFLOW_S3_ENDPOINT_URL=http://s3:9000

# MinIO
MINIO_ACCESS_KEY=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_PORT=9000
MINIO_PORT_UI=9001
MLFLOW_BUCKET_NAME=mlflow
DATA_REPO_BUCKET_NAME=data

# FastAPI
FASTAPI_PORT=8800

# MLflow Model Registry (compartido entre train_ecobici y FastAPI —
# deben coincidir para que /predict sirva el modelo que el DAG registró)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_NAME=ecobici_duracion_viaje
MLFLOW_MODEL_ALIAS=champion
